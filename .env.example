# Copie para .env.local (vercel dev) e configure as mesmas variáveis na Vercel:
# Project > Settings > Environment Variables
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key

# Tarefas de /api/notify (parecidos, avisos, expiração, fotos órfãs). A service role ignora as regras RLS:
# nunca use em front-end nem em variável pública.
SUPABASE_SERVICE_ROLE_KEY=
# Segredo longo e aleatório, enviado como "Authorization: Bearer ..." pelos webhooks e pelo cron da Vercel
CRON_SECRET=
# URL pública do site, usada nos links dos e-mails (sem barra no fim)
SITE_URL=https://seu-dominio.exemplo

# E-mails de aviso (vazio = só avisos dentro do site)
RESEND_API_KEY=
EMAIL_FROM=PetSOS <avisos@seu-dominio.exemplo>

# Fase futura: provedor de similaridade de imagem (vazio = desligado)
PETSOS_IMAGE_MATCHER=
